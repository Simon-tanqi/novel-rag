# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
.venv*/
venv/

# ===== 运行时自动生成（含用户隐私，不入库） =====
# config.json 含真实 API Key，只保留本地，用 config.example.json 做模板
config.json
novel_config.json
crash_log.txt
# .env 含真实 API Key，只保留本地，用 .env.example 做模板
.env
.env.local

# ===== 用户数据 / 受版权保护内容 =====
# data/ 存放小说原文与向量库（版权语料），不入库。
# 例外：data/demo/ 为内置原创示例（无版权风险），预置向量库随仓库分发，
# 保证 clone 后 0 分钟开箱即用（由 project_manager 自动注册）。
data/*
!data/demo/
chat_logs/

# ===== 本地模型文件 =====
# 模型不入库（体积大、可从 HuggingFace 重新下载）。
# 首次运行自动从 HF 下载；无网络环境可运行 scripts/download_models.py（内置国内镜像）。
# 如需将模型随仓库分发，注释掉下行并改用 Git LFS 管理大文件。
models/
.hf_cache/

# ===== 评测环境与产出（本地生成，不入库） =====
.ragas_venv/
ragas_out/
eval_results/

# ===== 测试与构建 =====
htmlcov/
.coverage
dist/
build/

# ===== IDE / OS =====
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ===== 中间产物目录（脚本临时输出，不入库） =====
temp/

# ===== 发布前清理：无关内容暂存回收站（不入库） =====
回收站/
